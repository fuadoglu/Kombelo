{
  "openapi": "3.1.0",
  "info": {
    "title": "Kombelo API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProfile",
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/boards/today": {
      "get": {
        "operationId": "getDailyBoard",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/boards/{boardId}/attempts": {
      "parameters": [
        {
          "name": "boardId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "startAttempt",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attempt"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/attempts/{attemptId}/result": {
      "parameters": [
        {
          "name": "attemptId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "submitResult",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Replay"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rankings": {
      "get": {
        "operationId": "getRankings",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ranking"
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "world",
                "country",
                "friends"
              ],
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "day",
                "week"
              ],
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/friend-invites": {
      "post": {
        "operationId": "inviteFriend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/friend-invites/{id}/accept": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "acceptFriend",
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/blocks": {
      "post": {
        "operationId": "blockPlayer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports": {
      "post": {
        "operationId": "reportNickname",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "abuse",
                      "impersonation",
                      "personal_information",
                      "other"
                    ]
                  }
                },
                "required": [
                  "code",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices/{id}/preferences": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "updateDevice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "locale": {
                    "type": "string"
                  },
                  "zone": {
                    "type": "string"
                  },
                  "daily": {
                    "type": "boolean"
                  },
                  "friends": {
                    "type": "boolean"
                  },
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "locale",
                  "zone",
                  "daily",
                  "friends"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Stable error code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "code",
          "nickname"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{8}$"
          },
          "nickname": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      },
      "Move": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "row",
          "col"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        }
      },
      "Replay": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moves"
        ],
        "properties": {
          "moves": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/components/schemas/Move"
            }
          }
        }
      },
      "Attempt": {
        "type": "object",
        "required": [
          "id",
          "boardId",
          "rulesVersion",
          "digest",
          "closesAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "boardId": {
            "type": "string"
          },
          "rulesVersion": {
            "type": "integer"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "score"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Board": {
        "type": "object",
        "required": [
          "id",
          "digest",
          "rulesVersion",
          "opensAt",
          "closesAt",
          "moveLimit",
          "grid",
          "trays"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "rulesVersion": {
            "type": "integer"
          },
          "opensAt": {
            "type": "string",
            "format": "date-time"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time"
          },
          "moveLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "grid": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[.0-4]{8}$"
            }
          },
          "trays": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "shape",
                  "rotation",
                  "color"
                ],
                "properties": {
                  "shape": {
                    "type": "string"
                  },
                  "rotation": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "color": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  }
                }
              }
            }
          }
        }
      },
      "Ranking": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Profile"
                },
                {
                  "type": "object",
                  "required": [
                    "score",
                    "rank"
                  ],
                  "properties": {
                    "score": {
                      "type": "integer"
                    },
                    "rank": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              ]
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_input",
              "unauthenticated",
              "forbidden",
              "not_found",
              "attempt_cap",
              "board_expired",
              "conflicting_replay",
              "not_terminal",
              "invalid_move",
              "rate_limited"
            ]
          }
        }
      }
    }
  }
}
